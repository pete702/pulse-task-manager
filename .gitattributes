# Auto detect text files and normalize to LF
* text=auto eol=lf

# Explicitly declare text files to use LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.lock text eol=lf

# Binary files
*.png binary
*.exe binary
*.dll binary
*.ico binary